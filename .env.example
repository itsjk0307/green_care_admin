# Backend API (default for this project)
# VITE_API_BASE_URL=http://192.168.0.61:8010/api/v1

# Dev proxy target (when VITE_API_BASE_URL is unset, requests use /api/v1 proxy)
# VITE_API_PROXY_TARGET=http://192.168.0.61:8010

# AI secretary assistant (/ai page) is served by the backend now —
# GEMINI_API_KEY/GROQ_API_KEY live in green_care_backend/.env, not here.

# Mobile (Expo): EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Course map basemap (satellite imagery under the drone tile overlay).
# Get a key: https://cloud.maptiler.com/account/keys
# If unset, the map falls back to Esri World Imagery and logs a warning.
VITE_MAPTILER_KEY=
